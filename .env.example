# ---- App ----
APP_ENV=development

# ---- Database ----
DATABASE_URL=sqlite:///./recoveryos.db

# ---- LLM provider: mock | gemini | openai | anthropic ----
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Payment provider: simulated | razorpay ----
PAYMENT_PROVIDER=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
